generator client {
  provider = "prisma-client-js"
}

datasource db {
  // MySQL da Hostinger (Business Web Hosting inclui MySQL).
  // Em dev roda o mesmo provider via Docker/Local MySQL.
  // DATABASE_URL no formato:
  //   mysql://user:pass@localhost/db?socket=/var/lib/mysql/mysql.sock
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Testimonial {
  id         String   @id @default(cuid())
  clientName String
  eventType  String? // ex: "Casamento", "Debutante", "Batizado"
  quote      String
  rating     Int      @default(5)
  photoUrl   String?
  published  Boolean  @default(true)
  order      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model TeamMember {
  id        String   @id @default(cuid())
  name      String
  role      String
  bio       String?
  photoUrl  String?
  published Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Partner {
  id        String   @id @default(cuid())
  name      String
  category  String? // ex: "Fotografia", "Buffet", "Decoração"
  logoUrl   String?
  website   String?
  published Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model GalleryImage {
  id        String   @id @default(cuid())
  url       String
  caption   String?
  category  String? // ex: "Casamento", "Debutante"
  published Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

// status: "available" | "unavailable" | "booked"
model AvailabilityDate {
  id     String   @id @default(cuid())
  date   DateTime @unique
  status String
  note   String?
}

// status: "novo" | "contatado" | "fechado" | "recusado"
model QuoteRequest {
  id          String    @id @default(cuid())
  name        String
  email       String
  phone       String
  eventType   String
  eventDate   DateTime?
  location    String?
  guestCount  String?
  partnerName String?
  message     String?
  status      String    @default("novo")
  createdAt   DateTime  @default(now())
}

model SiteSettings {
  id             Int     @id @default(1)
  heroTitle      String
  heroSubtitle   String
  aboutText      String
  instagramUrl   String?
  tiktokUrl      String?
  whatsappNumber String?
  email          String?
}

// ---- Comunidade das noivas ----

model BrideUser {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  cpf          String
  birthDate    DateTime
  avatarUrl    String?
  banned       Boolean  @default(false)
  createdAt    DateTime @default(now())

  posts     Post[]
  comments  Comment[]
  reactions Reaction[]
}

model Post {
  id        String   @id @default(cuid())
  authorId  String
  author    BrideUser @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content   String
  imageUrl  String?
  published Boolean  @default(false)
  createdAt DateTime @default(now())

  comments  Comment[]
  reactions Reaction[]

  @@index([authorId])
}

model Comment {
  id        String   @id @default(cuid())
  postId    String
  post      Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    BrideUser @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content   String
  published Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([postId])
  @@index([authorId])
}

// type: "amei" | "parabens" | "fofo" | "bravo"
model Reaction {
  id        String   @id @default(cuid())
  postId    String
  post      Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    BrideUser @relation(fields: [authorId], references: [id], onDelete: Cascade)
  type      String
  createdAt DateTime @default(now())

  @@unique([postId, authorId])
  @@index([authorId])
}

// ---- Book de casais ----

model Couple {
  id          String    @id @default(cuid())
  names       String // ex: "Ana & João"
  slug        String    @unique
  weddingDate DateTime?
  coverUrl    String?
  story       String?
  published   Boolean   @default(true)
  // Se aparece na página "Histórias reais" (/casais). Independente disso,
  // um casal publicado com data futura entra no "Próximo casamento" da home.
  showInStories Boolean @default(false)
  order       Int       @default(0)
  createdAt   DateTime  @default(now())

  media     CoupleMedia[]
  checklist ClientChecklist?
}

// ---- Bastidores ----

// type: "photo" | "video" (video = link do YouTube/Vimeo ou URL de arquivo de vídeo)
model BackstageMedia {
  id        String   @id @default(cuid())
  type      String
  url       String
  caption   String?
  published Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

// type: "photo" | "video" (video = link do YouTube/Vimeo ou URL de arquivo de vídeo)
model CoupleMedia {
  id       String  @id @default(cuid())
  coupleId String
  couple   Couple  @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  type     String
  url      String
  caption  String?
  order    Int     @default(0)

  @@index([coupleId])
}

// ---- Checklist dos noivos (clientes contratados) ----

// Cada casal cadastrado (em "Histórias reais", com data do casamento) pode
// ter um checklist próprio, acessado por um link privado (/checklist/<token>)
// — sem precisar de login. Nomes e data vêm do Couple.
model ClientChecklist {
  id        String   @id @default(cuid())
  coupleId  String   @unique
  couple    Couple   @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  token     String   @unique
  createdAt DateTime @default(now())

  items ChecklistItem[]
}

// phase: índice da fase em CHECKLIST_PHASES (src/lib/checklistTemplate.ts)
model ChecklistItem {
  id                    String          @id @default(cuid())
  checklistId           String
  checklist             ClientChecklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  phase                 Int
  title                 String
  note                  String?         @db.Text
  done                  Boolean         @default(false)
  doneAt                DateTime?
  priority              Boolean         @default(false)
  // "Não se aplica": não conta no progresso nem nos atrasos.
  notApplicable         Boolean         @default(false)
  notApplicableByCouple Boolean         @default(false)
  addedByCouple         Boolean         @default(false)
  order                 Int             @default(0)
  createdAt             DateTime        @default(now())

  @@index([checklistId])
}
